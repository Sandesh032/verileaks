pragma solidity ^0.8.24;

import { Ownable } from "@openzeppelin/contracts/access/Ownable.sol";
import { Ownable2Step } from "@openzeppelin/contracts/access/Ownable2Step.sol";
import { ReentrancyGuard } from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import { ISchellingVoting } from "./interfaces/ISchellingVoting.sol";
import { IJurorSelection } from "./interfaces/IJurorSelection.sol";
import { ISubmissionRegistry } from "./interfaces/ISubmissionRegistry.sol";
import { ITokenStakingLocks } from "./interfaces/ITokenStakingLocks.sol";

/// @title SchellingVoting
/// @notice Dispute state machine, commit–reveal voting, deterministic tally and the MVP incentive policy.
///
/// State machine (stored `Status`; COMMIT/REVEAL are time-derived phases of ACTIVE, see `phaseOf`)
/// ───────────────────────────────────────────────────────────────────────────────────────────────
///   (none) ──createDispute──► CREATED ──onJurorsSelected──► ACTIVE ──finalize──► FINALIZED
///                                │                            │ commit: t < commitDeadline
///                                │                            │ reveal: commitDeadline ≤ t < revealDeadline
///                                ├─ onSelectionFailed ─► CANCELLED   finalize: t ≥ revealDeadline
///                                └─ cancelDispute (after selectionTimeout) ─► CANCELLED      (or all revealed)
///   JURORS_SELECTED and COMMIT_PHASE of the suggested diagram are entered atomically in `onJurorsSelected`
///   (no separate transaction would add safety). Voting is impossible in CREATED.
///
/// Submitted vs revealed vs finalized
/// ──────────────────────────────────
///   • committed  : `commitVote` stored a hash. It carries NO weight in the tally.
///   • revealed   : `revealVote` proved the hash opens to (vote, salt). ONLY revealed votes are counted.
///   • finalized  : `finalize` fixed the outcome and settled all stakes. Irreversible, executes once.
///
/// Commitment (bound to dispute, contract, chain, juror, vote, salt)
///   commitment = keccak256(abi.encode(VOTE_TAG, block.chainid, address(this), disputeId, juror, uint8(vote), salt))
///   Off-chain (ethers v6): AbiCoder.defaultAbiCoder().encode(
///     ["bytes32","uint256","address","uint256","address","uint8","bytes32"], [...])  → keccak256
///   `salt` must be 32 uniformly random bytes generated by the juror and kept secret until reveal.
///
/// Tally (deterministic, on revealed votes only)
///   revealed < minReveals → INCONCLUSIVE     (insufficient reveals / zero reveals; NEVER defaults to FAKE)
///   REAL > FAKE           → REAL
///   FAKE > REAL           → FAKE
///   REAL == FAKE          → INCONCLUSIVE     (tie)
///
/// Incentive policy (MVP; assumptions & limits in docs/phase2-security.md)
/// ───────────────────────────────────────────────────────────────────────
///   • Eligible: only jurors drawn by VRF from the credential-gated pool; each locks `stakePerJuror` of FREE
///     stake in TokenStaking at selection. Locked stake cannot be withdrawn nor locked twice, so one stake
///     unit can never back two disputes (no over-commitment). Selection requires free ≥ stakePerJuror.
///   • Decisive outcome (REAL/FAKE): majority revealers keep their stake + share the penalty pool; minority
///     revealers lose `minorityPenaltyBps` of their locked stake (PARTIAL, capped at 50%: a minority vote is not
///     proof of dishonesty when evidence is ambiguous); non-revealers lose `nonRevealPenaltyBps`.
///   • INCONCLUSIVE: nobody is a "minority". Only non-revealers are penalised and the pool is shared equally
///     among revealers. If nobody revealed there is no recipient, so NOBODY is slashed (no burn, no treasury).
///   • Funding: rewards are funded ONLY by penalties (zero-sum transfer inside TokenStaking). No issuance, no
///     promise without backing. Rounding dust goes to the last recipient, so the pool is always fully paid out.
///   • When: penalties and rewards are applied atomically in `finalize` (≤ MAX_JURY jurors → bounded gas); the
///     reward is immediately withdrawable free stake. Atomicity makes duplicate slashing / duplicate rewards
///     impossible: `finalize` is guarded by the FINALIZED status.
///   • Config changes only affect disputes created afterwards (config is snapshotted per dispute).
///
/// @custom:security-contact security@verileaks.example
contract SchellingVoting is ISchellingVoting, Ownable2Step, ReentrancyGuard {
    // ── Types ───────────────────────────────────────────────────────────────
    struct Config {
        uint8 jurySize;
        uint8 minReveals;
        uint32 commitDuration;
        uint32 revealDuration;
        uint32 selectionTimeout;
        uint16 minorityPenaltyBps;
        uint16 nonRevealPenaltyBps;
        uint128 stakePerJuror;
    }

    struct Dispute {
        address creator;
        Status status;
        Outcome outcome;
        uint64 createdAt;
        uint64 commitDeadline;
        uint64 revealDeadline;
        uint16 committed;
        uint16 revealedReal;
        uint16 revealedFake;
        bytes32 submissionId;
        uint256 externalRef;
        Config cfg;
        address[] jurors;
    }

    struct JurorVote {
        bool selected;
        bool revealed;
        Vote vote;
        bytes32 commitment;
    }

    // ── Errors ──────────────────────────────────────────────────────────────
    error ZeroAddress();
    error NotCreator(address caller);
    error NotSelection(address caller);
    error UnknownSubmission(bytes32 submissionId);
    error UnknownDispute(uint256 disputeId);
    error InvalidStatus(uint256 disputeId, Status status);
    error InvalidJurorSet();
    error NotJuror(uint256 disputeId, address account);
    error CommitPhaseClosed(uint256 deadline, uint256 nowTs);
    error RevealPhaseNotStarted(uint256 commitDeadline, uint256 nowTs);
    error RevealPhaseClosed(uint256 deadline, uint256 nowTs);
    error RevealPhaseNotOver(uint256 revealDeadline, uint256 nowTs);
    error EmptyCommitment();
    error AlreadyCommitted(uint256 disputeId, address juror);
    error NoCommitment(uint256 disputeId, address juror);
    error AlreadyRevealed(uint256 disputeId, address juror);
    error InvalidVote();
    error CommitmentMismatch();
    error SelectionNotTimedOut(uint256 availableAt, uint256 nowTs);
    error InvalidConfig(string reason);

    // ── Events ──────────────────────────────────────────────────────────────
    event CreatorUpdated(address indexed creator, bool allowed);
    event ConfigUpdated(Config config);
    event DisputeCreated(
        uint256 indexed disputeId,
        address indexed creator,
        bytes32 indexed submissionId,
        uint256 externalRef,
        uint256 selectionRequestId
    );
    event JurorsSelected(uint256 indexed disputeId, address[] jurors, uint64 commitDeadline, uint64 revealDeadline);
    event DisputeCancelled(uint256 indexed disputeId, string reason);
    event VoteCommitted(uint256 indexed disputeId, address indexed juror, bytes32 commitment);
    event VoteRevealed(uint256 indexed disputeId, address indexed juror, Vote vote);
    event JurorSettled(uint256 indexed disputeId, address indexed juror, uint256 penalty, uint256 reward);
    event DisputeFinalized(
        uint256 indexed disputeId,
        Outcome outcome,
        uint256 revealedReal,
        uint256 revealedFake,
        uint256 penaltyPool,
        uint256 recipients
    );

    // ── Constants ───────────────────────────────────────────────────────────
    bytes32 public constant VOTE_TAG = keccak256("VERILEAKS_SCHELLING_VOTE_V1");
    uint8 public constant MIN_JURY = 3;
    uint8 public constant MAX_JURY = 15;
    uint32 public constant MIN_DURATION = 60;
    uint32 public constant MAX_DURATION = 30 days;
    /// @dev Hard cap on any slashing fraction: 50 %. Not governable.
    uint16 public constant MAX_PENALTY_BPS = 5000;
    uint256 private constant BPS = 10_000;

    // ── Wiring ──────────────────────────────────────────────────────────────
    IJurorSelection public immutable selection;
    ITokenStakingLocks public immutable staking;
    ISubmissionRegistry public immutable registry;

    // ── State ───────────────────────────────────────────────────────────────
    Config private _config;
    uint256 public disputeCount;
    mapping(address => bool) public isCreator;
    mapping(uint256 => Dispute) private _disputes;
    mapping(uint256 => mapping(address => JurorVote)) private _votes;

    // ── Construction ────────────────────────────────────────────────────────
    constructor(
        address initialOwner,
        IJurorSelection selection_,
        ITokenStakingLocks staking_,
        ISubmissionRegistry registry_,
        Config memory config_
    ) Ownable(initialOwner) {
        if (address(selection_) == address(0) || address(staking_) == address(0) || address(registry_) == address(0)) {
            revert ZeroAddress();
        }
        selection = selection_;
        staking = staking_;
        registry = registry_;
        _setConfig(config_);
    }

    // ── Governance ──────────────────────────────────────────────────────────
    function setCreator(address creator, bool allowed) external onlyOwner {
        if (creator == address(0)) revert ZeroAddress();
        isCreator[creator] = allowed;
        emit CreatorUpdated(creator, allowed);
    }

    /// @notice Affects only disputes created AFTER this call (in-flight disputes keep their snapshot).
    function setConfig(Config calldata config_) external onlyOwner {
        _setConfig(config_);
    }

    function _setConfig(Config memory c) private {
        if (c.jurySize < MIN_JURY || c.jurySize > MAX_JURY) revert InvalidConfig("jurySize");
        // A strict majority of the jury must reveal for a decisive outcome.
        if (c.minReveals == 0 || c.minReveals > c.jurySize || uint256(c.minReveals) * 2 <= c.jurySize) {
            revert InvalidConfig("minReveals");
        }
        if (c.commitDuration < MIN_DURATION || c.commitDuration > MAX_DURATION) revert InvalidConfig("commitDuration");
        if (c.revealDuration < MIN_DURATION || c.revealDuration > MAX_DURATION) revert InvalidConfig("revealDuration");
        if (c.selectionTimeout < MIN_DURATION || c.selectionTimeout > MAX_DURATION) {
            revert InvalidConfig("selectionTimeout");
        }
        if (c.minorityPenaltyBps > MAX_PENALTY_BPS || c.nonRevealPenaltyBps > MAX_PENALTY_BPS) {
            revert InvalidConfig("penalty>cap");
        }
        if (c.stakePerJuror == 0) revert InvalidConfig("stakePerJuror");
        _config = c;
        emit ConfigUpdated(c);
    }

    // ── Dispute creation ────────────────────────────────────────────────────
    modifier onlyCreator() {
        if (!isCreator[msg.sender]) revert NotCreator(msg.sender);
        _;
    }

    /// @inheritdoc ISchellingVoting
    /// @dev `externalRef` is opaque to this contract (ArbitratedBounty passes its bountyId); it is returned
    ///      unchanged by `resultOf` so that the outcome is unambiguously linked to the creator's object.
    function createDispute(bytes32 submissionId, uint256 externalRef, address excludedA, address excludedB)
        external
        override
        onlyCreator
        nonReentrant
        returns (uint256 disputeId)
    {
        if (!registry.submissionExists(submissionId)) revert UnknownSubmission(submissionId);

        disputeId = ++disputeCount;
        Dispute storage d = _disputes[disputeId];
        d.creator = msg.sender;
        d.status = Status.CREATED;
        d.createdAt = uint64(block.timestamp);
        d.submissionId = submissionId;
        d.externalRef = externalRef;
        d.cfg = _config; // snapshot

        uint256 requestId =
            selection.requestSelection(disputeId, d.cfg.jurySize, d.cfg.stakePerJuror, excludedA, excludedB);

        emit DisputeCreated(disputeId, msg.sender, submissionId, externalRef, requestId);
    }

    // ── Selection callbacks (JurorSelection only) ───────────────────────────
    modifier onlySelection() {
        if (msg.sender != address(selection)) revert NotSelection(msg.sender);
        _;
    }

    /// @inheritdoc ISchellingVoting
    /// @dev Reverts (which JurorSelection catches) if the dispute is no longer CREATED, the juror set is
    ///      malformed, or any juror lacks free stake. A revert leaves NO stake locked.
    function onJurorsSelected(uint256 disputeId, address[] calldata jurors) external override onlySelection {
        Dispute storage d = _disputes[disputeId];
        if (d.status != Status.CREATED) revert InvalidStatus(disputeId, d.status);
        uint256 n = jurors.length;
        if (n != d.cfg.jurySize) revert InvalidJurorSet();

        for (uint256 i; i < n; ++i) {
            address j = jurors[i];
            JurorVote storage jv = _votes[disputeId][j];
            if (j == address(0) || jv.selected) revert InvalidJurorSet(); // zero / duplicate
            jv.selected = true;
            staking.lockStake(j, d.cfg.stakePerJuror);
        }
        d.jurors = jurors;
        d.status = Status.ACTIVE;
        d.commitDeadline = uint64(block.timestamp) + d.cfg.commitDuration;
        d.revealDeadline = d.commitDeadline + d.cfg.revealDuration;

        emit JurorsSelected(disputeId, jurors, d.commitDeadline, d.revealDeadline);
    }

    /// @inheritdoc ISchellingVoting
    /// @dev Idempotent / non-reverting for disputes that are not CREATED (called from a VRF callback path).
    function onSelectionFailed(uint256 disputeId) external override onlySelection {
        Dispute storage d = _disputes[disputeId];
        if (d.status == Status.CREATED) {
            d.status = Status.CANCELLED;
            emit DisputeCancelled(disputeId, "selection failed");
        }
    }

    /// @notice Anyone may cancel a dispute whose randomness has not arrived within `selectionTimeout`.
    ///         Late randomness is ignored afterwards. Nothing is locked in CREATED, so nothing needs refunding.
    function cancelDispute(uint256 disputeId) external nonReentrant {
        Dispute storage d = _disputes[disputeId];
        if (d.status != Status.CREATED) revert InvalidStatus(disputeId, d.status);
        uint256 availableAt = uint256(d.createdAt) + d.cfg.selectionTimeout;
        if (block.timestamp < availableAt) revert SelectionNotTimedOut(availableAt, block.timestamp);

        d.status = Status.CANCELLED;
        selection.cancelSelection(disputeId);
        emit DisputeCancelled(disputeId, "selection timeout");
    }

    // ── Commit / reveal ─────────────────────────────────────────────────────
    /// @notice Store a hidden vote. Allowed only for selected jurors while `block.timestamp < commitDeadline`.
    function commitVote(uint256 disputeId, bytes32 commitment) external {
        Dispute storage d = _disputes[disputeId];
        if (d.status != Status.ACTIVE) revert InvalidStatus(disputeId, d.status);
        if (block.timestamp >= d.commitDeadline) revert CommitPhaseClosed(d.commitDeadline, block.timestamp);
        if (commitment == bytes32(0)) revert EmptyCommitment();

        JurorVote storage jv = _votes[disputeId][msg.sender];
        if (!jv.selected) revert NotJuror(disputeId, msg.sender);
        if (jv.commitment != bytes32(0)) revert AlreadyCommitted(disputeId, msg.sender);

        jv.commitment = commitment;
        unchecked {
            d.committed++;
        }
        emit VoteCommitted(disputeId, msg.sender, commitment);
    }

    /// @notice Open a commitment. Allowed while commitDeadline ≤ block.timestamp < revealDeadline.
    function revealVote(uint256 disputeId, Vote vote, bytes32 salt) external {
        Dispute storage d = _disputes[disputeId];
        if (d.status != Status.ACTIVE) revert InvalidStatus(disputeId, d.status);
        if (block.timestamp < d.commitDeadline) revert RevealPhaseNotStarted(d.commitDeadline, block.timestamp);
        if (block.timestamp >= d.revealDeadline) revert RevealPhaseClosed(d.revealDeadline, block.timestamp);
        if (vote != Vote.REAL && vote != Vote.FAKE) revert InvalidVote();

        JurorVote storage jv = _votes[disputeId][msg.sender];
        if (!jv.selected) revert NotJuror(disputeId, msg.sender);
        if (jv.commitment == bytes32(0)) revert NoCommitment(disputeId, msg.sender);
        if (jv.revealed) revert AlreadyRevealed(disputeId, msg.sender);
        if (commitmentFor(disputeId, msg.sender, vote, salt) != jv.commitment) revert CommitmentMismatch();

        jv.revealed = true;
        jv.vote = vote;
        if (vote == Vote.REAL) d.revealedReal++;
        else d.revealedFake++;

        emit VoteRevealed(disputeId, msg.sender, vote);
    }

    /// @notice The exact commitment a juror must submit. Pure function of its inputs plus this contract/chain.
    function commitmentFor(uint256 disputeId, address juror, Vote vote, bytes32 salt) public view returns (bytes32) {
        return keccak256(abi.encode(VOTE_TAG, block.chainid, address(this), disputeId, juror, uint8(vote), salt));
    }

    // ── Finalization + settlement ───────────────────────────────────────────
    /// @notice Fix the outcome and settle all stakes. Permissionless; executes at most once per dispute.
    function finalize(uint256 disputeId) external nonReentrant {
        Dispute storage d = _disputes[disputeId];
        if (d.status != Status.ACTIVE) revert InvalidStatus(disputeId, d.status);

        uint256 n = d.jurors.length;
        uint256 real = d.revealedReal;
        uint256 fake = d.revealedFake;
        uint256 revealed = real + fake;
        if (block.timestamp < d.revealDeadline && revealed != n) {
            revert RevealPhaseNotOver(d.revealDeadline, block.timestamp);
        }

        // ── Deterministic tally ──
        Outcome outcome;
        if (revealed < d.cfg.minReveals) outcome = Outcome.INCONCLUSIVE;
        else if (real > fake) outcome = Outcome.REAL;
        else if (fake > real) outcome = Outcome.FAKE;
        else outcome = Outcome.INCONCLUSIVE;

        Vote winning = outcome == Outcome.REAL ? Vote.REAL : (outcome == Outcome.FAKE ? Vote.FAKE : Vote.NONE);
        bool decisive = winning != Vote.NONE;
        uint256 recipients = decisive ? (winning == Vote.REAL ? real : fake) : revealed;

        uint256 stake = d.cfg.stakePerJuror;
        // Without any revealer there is nobody to receive a penalty pool → nobody is slashed.
        uint256 nonRevealPenalty = recipients == 0 ? 0 : (stake * d.cfg.nonRevealPenaltyBps) / BPS;
        uint256 minorityPenalty = decisive ? (stake * d.cfg.minorityPenaltyBps) / BPS : 0;

        // ── Effects BEFORE any external call ──
        d.status = Status.FINALIZED;
        d.outcome = outcome;

        // ── Pass 1: penalties into the pool (held as this contract's free stake), unlock the rest ──
        uint256 pool = 0;
        for (uint256 i = 0; i < n; ++i) {
            address j = d.jurors[i];
            JurorVote storage jv = _votes[disputeId][j];
            uint256 penalty = 0;
            if (!jv.revealed) penalty = nonRevealPenalty;
            else if (decisive && jv.vote != winning) penalty = minorityPenalty;

            if (penalty > 0) {
                pool += penalty;
                emit JurorSettled(disputeId, j, penalty, 0);
                staking.slashStake(j, address(this), penalty);
            } else {
                emit JurorSettled(disputeId, j, 0, 0);
            }
            if (stake > penalty) staking.unlockStake(j, stake - penalty);
        }

        // ── Pass 2: distribute the pool equally among recipients; the last one takes the rounding dust ──
        if (pool > 0) {
            uint256 paid = 0;
            uint256 seen = 0;
            uint256 share = pool / recipients;
            for (uint256 i = 0; i < n; ++i) {
                address j = d.jurors[i];
                JurorVote storage jv = _votes[disputeId][j];
                if (!jv.revealed || (decisive && jv.vote != winning)) continue;
                unchecked {
                    ++seen;
                }
                uint256 reward = seen == recipients ? pool - paid : share;
                paid += reward;
                if (reward > 0) {
                    // Pay from this contract's free stake via the lock+slash primitives (locker can only move
                    // locked stake, so first lock the amount we are about to pay out).
                    emit JurorSettled(disputeId, j, 0, reward);
                    staking.lockStake(address(this), reward);
                    staking.slashStake(address(this), j, reward);
                }
            }
        }

        emit DisputeFinalized(disputeId, outcome, real, fake, pool, recipients);
    }

    // ── Views ───────────────────────────────────────────────────────────────
    function config() external view returns (Config memory) {
        return _config;
    }

    /// @inheritdoc ISchellingVoting
    function resultOf(uint256 disputeId)
        external
        view
        override
        returns (Status status, Outcome outcome, address creator, uint256 externalRef, bytes32 submissionId)
    {
        Dispute storage d = _disputes[disputeId];
        return (d.status, d.outcome, d.creator, d.externalRef, d.submissionId);
    }

    function phaseOf(uint256 disputeId) public view returns (Phase) {
        Dispute storage d = _disputes[disputeId];
        Status s = d.status;
        if (s == Status.NONE) return Phase.NONE;
        if (s == Status.CREATED) return Phase.CREATED;
        if (s == Status.FINALIZED) return Phase.FINALIZED;
        if (s == Status.CANCELLED) return Phase.CANCELLED;
        if (block.timestamp < d.commitDeadline) return Phase.COMMIT;
        if (block.timestamp < d.revealDeadline) return Phase.REVEAL;
        return Phase.AWAITING_FINALIZATION;
    }

    struct DisputeInfo {
        address creator;
        Status status;
        Outcome outcome;
        uint64 createdAt;
        uint64 commitDeadline;
        uint64 revealDeadline;
        uint16 committed;
        uint16 revealedReal;
        uint16 revealedFake;
        bytes32 submissionId;
        uint256 externalRef;
        Config cfg;
        address[] jurors;
    }

    function getDispute(uint256 disputeId) external view returns (DisputeInfo memory info) {
        Dispute storage d = _disputes[disputeId];
        info = DisputeInfo({
            creator: d.creator,
            status: d.status,
            outcome: d.outcome,
            createdAt: d.createdAt,
            commitDeadline: d.commitDeadline,
            revealDeadline: d.revealDeadline,
            committed: d.committed,
            revealedReal: d.revealedReal,
            revealedFake: d.revealedFake,
            submissionId: d.submissionId,
            externalRef: d.externalRef,
            cfg: d.cfg,
            jurors: d.jurors
        });
    }

    function jurorsOf(uint256 disputeId) external view returns (address[] memory) {
        return _disputes[disputeId].jurors;
    }

    function voteOf(uint256 disputeId, address juror)
        external
        view
        returns (bool selected, bool committed, bool revealed, Vote vote)
    {
        JurorVote storage jv = _votes[disputeId][juror];
        return (jv.selected, jv.commitment != bytes32(0), jv.revealed, jv.vote);
    }
}
