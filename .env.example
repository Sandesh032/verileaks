# Environment Variables — VeriLeaks Phase 1
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Ethereum / Foundry ──────────────────────────────────────────────────────
# Private key for deployment (hex, no 0x prefix for Foundry scripts)
# For local Anvil: use one of the default test keys printed by `anvil`
# Example default Anvil key: ac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
PRIVATE_KEY=

# RPC URL for the target network
# Local Anvil:   http://127.0.0.1:8545
# Sepolia:       https://sepolia.infura.io/v3/<YOUR_INFURA_PROJECT_ID>
RPC_URL=http://127.0.0.1:8545

# Etherscan API key (optional; only needed for --verify on Sepolia)
ETHERSCAN_API_KEY=

# ── IPFS / Pinata ───────────────────────────────────────────────────────────
# Sign up at https://app.pinata.cloud
# Credentials: Account → API Keys → New Key → Admin
PINATA_API_URL=https://api.pinata.cloud
PINATA_API_KEY=
PINATA_API_SECRET=

# ── Deployed contract addresses (filled after deployment) ───────────────────
SUBMISSION_REGISTRY_ADDRESS=
TOKEN_STAKING_ADDRESS=
HTLC_ADDRESS=
