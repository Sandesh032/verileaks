{
  "name": "verileaks-phase1-tools",
  "version": "1.0.0",
  "description": "VeriLeaks Phase 1 off-chain tooling: Merkle tree generation and IPFS storage abstraction",
  "type": "module",
  "license": "MIT",
  "main": "src/index.js",
  "scripts": {
    "start": "node start-all.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=e2e.test.js --verbose",
    "test:merkle": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=src/merkle --verbose",
    "test:storage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=src/storage --verbose",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=integration --verbose",
    "test:watchtower": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathPattern=src/watchtower --verbose",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js src/e2e.test.js --verbose --runInBand",
    "watchtower": "node src/watchtower/cli.js",
    "watchtower:cluster": "node src/watchtower/cli.js --cluster",
    "deploy:all": "~/.foundry/bin/forge script script/DeployAll.s.sol:DeployAll --broadcast",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:preview": "npm --prefix frontend run preview",
    "workflow:demo": "node src/workflow.js"
  },
  "dependencies": {
    "@chainlink/contracts": "1.5.0",
    "@openzeppelin/contracts": "5.6.1",
    "@semaphore-protocol/contracts": "4.14.3",
    "@semaphore-protocol/group": "4.14.3",
    "@semaphore-protocol/identity": "4.14.3",
    "@semaphore-protocol/proof": "4.14.3",
    "@zk-kit/lean-imt.sol": "2.0.1",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^5.3.0",
    "form-data": "^4.0.1",
    "multer": "^2.4.0",
    "node-fetch": "^3.3.2",
    "poseidon-solidity": "0.0.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.3.1"
  },
  "jest": {
    "transform": {},
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.js"
    ]
  }
}
